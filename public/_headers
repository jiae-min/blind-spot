# Cloudflare Pages HTTP 헤더 (3.4 §4, D-001)
# Base.astro의 <meta> CSP·referrer는 로컬 미리보기용 대비책으로 남겨 둠. 둘을 바꿀 때는 함께 바꿀 것.
# 검색 노출은 페이지마다 <meta name="robots">로 정함 (v4 3.4 §7, D-041): 승인된 내용만 있는 페이지만 허용.

/*
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Pretendard 글꼴 조각: 버전 폴더라 내용이 바뀌지 않음 → 한 번 받으면 다시 받지 않게 (D-042)
/fonts/*
  Cache-Control: public, max-age=31536000, immutable


# 긴급 도움 오프라인 보기용 서비스 워커 (D-028): 늘 최신을 받도록 캐시 금지.
# 서비스 워커가 같은 사이트의 긴급 도움 페이지를 받아 저장해야 해서 connect-src는 'self' (외부는 여전히 차단).
/sw.js
  Cache-Control: no-cache
