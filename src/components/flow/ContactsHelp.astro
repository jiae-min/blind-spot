---
// 하단 '긴급 연락처와 도움말' (v0.5 후속, D-039) — 결과·타임라인 뒤
// 통합: 늘 보이는 긴급번호(112·119·1366) → (폭력 케이스) 지역 연결 센터 → 상황별 연락처 아코디언
//       → 기관별 전화 예시 → 전화할 때 전하면 좋은 내용 → 전화가 어려울 때 대안
// 상단 헤더의 '긴급 도움' 버튼은 어떤 답을 해도 숨기지 않음. 이 구역은 사용자가 직접 접을 수만 있음.
// 신고 의사로 이 구역을 자동으로 숨길지는 운영자 결정 대기 (docs/v0.5-followup/DECISIONS_AND_OPEN_ISSUES.md §3) — 구현하지 않음.
import EmergencyTop from '../wf/EmergencyTop.astro';
import CallCategories from '../wf/CallCategories.astro';
import ContactScript from '../wf/ContactScript.astro';
import Alternatives from '../wf/Alternatives.astro';
import CenterMatch from './CenterMatch.astro';
import { href, type CaseDef, type CaseId } from '../../data/cases';
interface Props { c: CaseDef; horizon: string }
const { c, horizon } = Astro.props;
// 케이스별로 먼저 보여 줄 분류 (data/emergency.ts의 분류 ID). 전체는 긴급 도움 페이지에.
const CATS: Record<CaseId, string[]> = {
  'domestic-violence': ['violence', 'legal', 'migrant', 'youth'],
  'sexual-violence': ['sexual', 'violence', 'legal', 'youth'],
  'family-care': ['welfare', 'abuse', 'youth'],
  'livelihood-education': ['welfare', 'legal', 'youth'],
  'reclusive-youth': ['welfare', 'youth'],
};
const AGENCIES: Record<CaseId, string[]> = {
  'domestic-violence': ['1366', '해바라기센터'],
  'sexual-violence': ['1366', '해바라기센터'],
  'family-care': ['129 보건복지상담센터'],
  'livelihood-education': ['129 보건복지상담센터'],
  'reclusive-youth': ['129 보건복지상담센터'],
};
const violence = c.id === 'domestic-violence' || c.id === 'sexual-violence';
const TELL = [
  { k: '지금 있는 곳', v: '시·군·구 정도면 충분해요. 정확한 주소를 말하기 어려우면 근처 건물이나 역 이름도 괜찮아요.' },
  { k: '지금 위험한지', v: '위험한 사람이 가까이 있는지, 다친 곳이 있는지요.' },
  { k: '필요한 도움', v: '위에서 고른 도움을 그대로 말해도 돼요.' },
  { k: '함께 있는 사람', v: '아이나 돌봐야 할 가족, 다친 사람이 함께 있는지요.' },
  { k: '안전하게 다시 연락받을 방법', v: '전화를 받기 어려운 시간이나, 문자로 받아도 괜찮은지요.' },
];
const p = `${c.id}-${horizon}`;
---
<div class="sec-group ch" data-ch>
  <section id="contacts" class="sec tick ch-top" tabindex="-1">
    <div class="ch-head">
      <h2>긴급 연락처와 도움말</h2>
      <button type="button" class="ch-toggle btn-accent" aria-expanded="true" aria-controls={`${p}-ch-body`} data-ch-toggle>이 구역 접기</button>
    </div>
    <div data-ch-part>
      <p class="desc ch-lead">지금 바로 연락할 수 있는 곳이에요. 신고하지 않아도 상담부터 받을 수 있는 곳도 있어요.</p>
      <EmergencyTop prefix={`${p}-top`} />
    </div>
  </section>

  {/* 긴급 도움 페이지처럼 주제마다 구역 상자 하나 */}
  <div class="sec-group" id={`${p}-ch-body`} data-ch-part>
    {violence && (
      <section class="sec tick">
        <h2>지역에 연결해 둔 해바라기센터</h2>
        <CenterMatch child={c.id === 'sexual-violence'} />
      </section>
    )}

    <section class="sec tick">
      <h2>상황별 연락처</h2>
      <p class="desc sub">필요한 분류를 눌러 펼쳐 보세요. 여러 개를 함께 열 수 있어요.</p>
      <CallCategories ids={CATS[c.id]} prefix={p} />
      <p class="more"><a href={href('help/#contacts')}>모든 상황별 연락처 보기 →</a></p>
    </section>

    <section class="sec tick">
      <h2>전화할 때 이렇게 말해 보세요</h2>
      <p class="desc sub">거는 곳을 고르고, 주황색 괄호 부분만 내 상황에 맞게 바꿔 말해 보세요. 필요 없는 부분은 빼도 괜찮아요.</p>
      <ContactScript agencies={AGENCIES[c.id]} />
    </section>

    <section class="sec tick">
      <h2>전화할 때 전하면 좋은 내용</h2>
      <p class="desc sub">말하기 어려운 건 빼도 괜찮아요. 상담원이 차례로 물어봐 줄 거예요.</p>
      <dl class="tell">
        {TELL.map((t) => <div><dt>{t.k}</dt><dd>{t.v}</dd></div>)}
      </dl>
    </section>

    <section class="sec tick">
      <h2>연결이 안 되거나 전화가 어려울 때</h2>
      <Alternatives />
    </section>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-ch]').forEach((sec) => {
    const btn = sec.querySelector<HTMLButtonElement>('[data-ch-toggle]')!;
    const parts = [...sec.querySelectorAll<HTMLElement>('[data-ch-part]')];
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') !== 'true';
      btn.setAttribute('aria-expanded', String(open));
      parts.forEach((x) => (x.hidden = !open));
      btn.textContent = open ? '이 구역 접기' : '이 구역 펼치기';
    });
    // '긴급 연락처 바로 보기'로 오면 접혀 있어도 펼침
    const openIfTarget = () => { if (location.hash === '#contacts' && btn.getAttribute('aria-expanded') !== 'true') btn.click(); };
    window.addEventListener('hashchange', openIfTarget);
    document.querySelectorAll('a[href="#contacts"]').forEach((a) => a.addEventListener('click', () => setTimeout(openIfTarget)));
  });
</script>

<style>
  .ch-top { scroll-margin-top: 76px; }
  .ch-top:focus { outline: none; }
  .ch-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-3); margin-bottom: var(--space-4); }
  .ch-head h2 { margin: 0; }
  .ch-toggle { min-height: 44px; padding: 0 16px; border: 1px solid var(--color-text); background: none; font: inherit; font-weight: 700; color: inherit; cursor: pointer; }
  [data-ch-part][hidden] { display: none; }
  .ch-lead { margin: 0 0 var(--space-5); }
  .ch .sec > h2 { margin-bottom: var(--space-3); }
  .sub { margin: 0 0 var(--space-4); }
  .more { margin: var(--space-3) 0 0; font-weight: 700; }
  .tell { display: grid; margin: 0; border: 1px solid var(--color-text); }
  .tell div { display: grid; grid-template-columns: minmax(8em, 13em) 1fr; gap: 4px 16px; padding: 12px 18px; }
  .tell div + div { border-top: 1px solid var(--line); }
  .tell dt { font-weight: 800; }
  .tell dd { margin: 0; }
  @media (max-width: 600px) { .tell div { grid-template-columns: 1fr; } }
</style>
