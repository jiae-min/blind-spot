---
// 지역 고르기 (v0.5 후속, D-040): 서울·경기 두 버튼 → 바로 아래에 구(서울) / 시·군(경기) 버튼 → 일반구가 있는 시는 구 버튼
// 기존 지역 질문(wf/Region.astro)과 같은 방식·모양. GPS·주소 입력 없음. 고른 값은 이 화면에서만 쓰고 저장·URL·전송 없음.
// 고를 때마다 'bs-region' 이벤트(detail: { sido, key — 연결표 키, 덜 골랐으면 '' })를 보냄 → 센터 연결·조건 확인이 받음
import Choice from '../wf/Choice.astro';
import { SEOUL, GYEONGGI } from '../../data/centers';
interface Props { qid: string; title: string; current?: boolean; uid: string }
const { qid, title, current = false, uid } = Astro.props;
const opt = (list: string[]) => list.map((v) => ({ value: v, label: v }));
const hint = `${current ? '주민등록 주소가 아니라 지금 계신 곳이에요. ' : ''}고르지 않아도 안내는 그대로 볼 수 있어요. 고른 지역을 다시 누르면 선택이 풀려요. 위치 정보(GPS)는 쓰지 않아요.`;
---
<div class="region" data-q={qid} data-region-root>
  <Choice name={`${uid}-sido`} legend={title} hint={hint} withUnknown={false} cols={2} colsM={2}
          options={[{ value: '서울특별시', label: '서울' }, { value: '경기도', label: '경기' }]} />
  <div class="sub" data-sub="서울특별시" hidden>
    <Choice name={`${uid}-seoul`} legend="서울 어느 구에 계신가요?" srLegend withUnknown={false} options={opt(SEOUL)} />
  </div>
  <div class="sub" data-sub="경기도" hidden>
    <Choice name={`${uid}-gg`} legend="경기도 어느 시·군에 계신가요?" srLegend withUnknown={false} options={opt(GYEONGGI.map((g) => g.city))} />
  </div>
  {GYEONGGI.filter((g) => g.districts.length).map((g) => (
    <div class="sub sub--dist" data-dist={g.city} hidden>
      <Choice name={`${uid}-gg-${g.city}`} legend={`${g.city} 어느 구에 계신가요?`} srLegend withUnknown={false} options={opt(g.districts)} cols={Math.min(4, g.districts.length)} />
    </div>
  ))}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-region-root]').forEach((root) => {
    const val = (pre: string) => root.querySelector<HTMLInputElement>(`input[name="${pre}"]:checked`)?.value ?? '';
    const name = (sel: string) => root.querySelector<HTMLInputElement>(`${sel} input`)!.name;
    const sidoName = name('.choice'), seoulName = name('[data-sub="서울특별시"]'), ggName = name('[data-sub="경기도"]');
    const blocks = [...root.querySelectorAll<HTMLElement>('[data-sub], [data-dist]')];
    const clear = (b: HTMLElement) => b.querySelectorAll<HTMLInputElement>('input').forEach((i) => (i.checked = false));
    const sync = () => {
      const s = val(sidoName), city = s === '경기도' ? val(ggName) : '';
      blocks.forEach((b) => {
        const show = b.dataset.sub ? b.dataset.sub === s : b.dataset.dist === city;
        if (!show) clear(b);
        b.hidden = !show;
      });
      let key = '';
      if (s === '서울특별시' && val(seoulName)) key = `서울특별시/서울특별시/${val(seoulName)}`;
      if (s === '경기도' && city) {
        const dist = root.querySelector<HTMLElement>(`[data-dist="${city}"]`);
        const d = dist ? dist.querySelector<HTMLInputElement>('input:checked')?.value : '';
        key = dist ? (d ? `경기도/${city}/${d}` : '') : `경기도/${city}`;
      }
      root.dataset.pickedSido = s;
      root.dataset.pickedKey = key;
      root.dispatchEvent(new CustomEvent('bs-region', { bubbles: true, detail: { sido: s, key } }));
    };
    root.addEventListener('change', sync);
    root.addEventListener('bs-reset', () => { clear(root); sync(); });
    window.addEventListener('pageshow', (e) => { if (e.persisted) root.dispatchEvent(new Event('bs-reset')); });
  });
</script>

<style>
  /* 하위 단계: 바로 아래 옅은 바탕에 버튼만 (기존 지역 질문과 같은 모양) */
  .region :global(.choice) { margin-bottom: 0; }
  .sub { margin-top: var(--space-3); padding: var(--space-4); background: rgba(123, 158, 137, .08); }
  .sub[hidden] { display: none; }
</style>
