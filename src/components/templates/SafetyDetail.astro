---
// SCR-S-001 긴급/피해지원 상세 (가정폭력·성폭력 단기) — 와이어프레임
// 순서(D-039, v0.5 후속): 바로 보기 버튼 → 질문(위험 1문항·선택 위치·필요한 도움, 고른 항목 아래 결과) → 타임라인
//   → 지금 필요한 조치 → 이후 → FAQ → 긴급 연락처와 도움말(연락처·센터·전화 문장·전달 내용·대안) → 근거
// (이전 순서 D-009: 연락처를 FAQ 앞에 두었음 → 결과·타임라인 뒤로 이동)
// - 안내를 다 보고 실행할 확신이 들 때 연락처를 보여 줌. 급한 사람은 상단 버튼으로 연락처에 바로 감.
// - 성폭력 3문항(경과시간 → 지역 → 약물 의심) 순서 고정, 모두 건너뛰기 가능, 답 요약 카드 금지
// - 답은 저장·URL·분석 전송 금지 (EVT-SAFE-INPUT). 사건 상세 서술을 요구하지 않음.
import Slot from '../wf/Slot.astro';
import Choice from '../wf/Choice.astro';
import Conditions from '../wf/Conditions.astro';
import Faq from '../wf/Faq.astro';
import GuideCard from '../wf/GuideCard.astro';
import Region from '../wf/Region.astro';
import Questionnaire from '../flow/Questionnaire.astro';
import ContactsHelp from '../flow/ContactsHelp.astro';
import { STEP_RULES } from '../../data/step-rules';
import { contentFor } from '../../data/content';
import { COPY, HORIZONS, href, type CaseDef } from '../../data/cases';

interface Props { c: CaseDef; h: (typeof HORIZONS)[number] }
const { c, h } = Astro.props;
const other = HORIZONS.find((x) => x.id !== h.id)!;
const copy = COPY[c.id]![h.id];
const guides = contentFor(c.id, h.id, 'guide');
const faqs = contentFor(c.id, h.id, 'faq');
const hasDrafts = [...guides, ...faqs].some((i) => i.draft);

// 3.3 §5 timeBracket — 경계가 겹치지 않게
const TIME = [
  ['lt1h', '1시간 이내'], ['1-12h', '1~12시간'], ['12-36h', '12~36시간'], ['36-72h', '36~72시간'],
  ['3-5d', '3~5일'], ['5-7d', '5~7일'], ['1-2w', '1~2주'], ['2w-1m', '2주~1개월'],
  ['1-3m', '1~3개월'], ['3-6m', '3~6개월'], ['6m-1y', '6개월~1년'], ['1y+', '1년 이상'],
].map(([value, label]) => ({ value, label }));
// 3.3 §5 drugConcern — 문구는 초안 (D-008, 콘텐츠 검수 필요)
const DRUG = [
  { value: 'known', label: '약물이 쓰인 걸 알고 있어요' },
  { value: 'suspected-memory-gap', label: '기억이 끊긴 부분이 있어요' },
  { value: 'no-sign', label: '그런 징후는 없었어요' },
  { value: 'unknown', label: '모르겠어요' },
  { value: 'skip', label: '건너뛰기' },
];
const isSV = c.id === 'sexual-violence';
// 이전 설계(D-008)의 성폭력 3문항(경과시간 → 지역 → 약물)과 가정폭력 지역 질문.
// v0.5 후속 설계(단기 1문항 + 선택 위치)와 겹쳐서 기본으로 끔 — 지우지 않고 남겨 둠. 계속 쓸지는 운영자 결정 (D-039)
const LEGACY_QUESTIONS = false;
---
<div class="wrap page">
  {/* 구역마다 가는 선 상자 + 모서리 사각형 (.sec .tick) */}
  <section class="sec tick opening">
  <p class="kicker">{c.label} · {h.title}</p>
  <div class="title-row">
    <h1>{copy.title}</h1>
    <a class="jump btn-accent" href="#contacts">긴급 연락처 바로 보기 ↓</a>
  </div>
  <p class="lead desc">{copy.lead}</p>
  {hasDrafts && (
    <p class="state-draft" role="note">
      <strong>검증 전 초안이 포함된 미리보기예요.</strong> 전문가 검토와 QA를 마치지 않은 내용이니, 실제로 이용하기 전에 해당 기관에 꼭 확인해 주세요.
    </p>
  )}

  {LEGACY_QUESTIONS && (isSV ? (
    <Conditions mode="safe">
      <Choice name="sv-time" legend="1. 일이 있고 얼마나 지났나요?" options={TIME} />
      <Region name="sv-region" legend="2. 어느 지역에 계신가요?" />
      <Choice name="sv-drug" legend="3. 약물이 쓰였을 수 있나요?" options={DRUG} withUnknown={false} />
    </Conditions>
  ) : (
    <Conditions mode="safe">
      <Region name="dv-region" legend="어느 지역에 계신가요?" />
      <Slot label="그 밖의 질문" cmp="CMP-INPUT-01" note="가정폭력 경로의 다른 질문 항목은 아직 정해지지 않음(D-008). 건너뛰기 가능·저장 없음." />
    </Conditions>
  ))}
  </section>

  {/* 질문마다 구역 상자 하나 (v0.5 후속 질문). 답하지 않아도 아래 조치는 모두 보임 */}
  <Questionnaire c={c} h={h.id} title="지금 필요한 도움 찾기" />

  {/* 지금 필요한 조치: 단계별 카드 (CMP-ALERT-01 / CMP-CARD-01). 신고·사건 설명을 요구하지 않음 */}
  <section class="sec tick">
    <h2>지금 필요한 조치</h2>
    {guides.length > 0 ? (
      <div class="guides" data-steps data-rules={isSV ? JSON.stringify(STEP_RULES) : undefined}>{guides.map((g, i) => <GuideCard item={g} step={i + 1} />)}</div>
    ) : (
      <Slot label="단계별 조치 카드" cmp="CMP-CARD-01" tone="critical" note="답하지 않아도 항상 보이는 안전 행동을 단계 순서로. 신고·사건 설명을 요구하지 않음.">
        <ol class="first">
          <li>[1단계 조치]</li>
          <li>[2단계 조치]</li>
        </ol>
      </Slot>
    )}
  </section>

  <section class="sec tick">
  <Slot label="이후 일정" note="며칠·몇 주 뒤에 확인할 일. 관련 장기 경로로 연결.">
    <p><a href={href(`cases/${c.id}/${other.id}/`)}>{other.title} ({other.sub}) 보기 →</a></p>
  </Slot>

  </section>

  <section class="sec tick">
    <h2>궁금할 수 있는 질문</h2>
    <Faq items={faqs} />
  </section>

  {/* 결과·타임라인 뒤: 연락처·센터·전화 문장·전달 내용·대안을 한 구역에 (D-039). 급하면 상단 버튼으로 바로 이동 */}
  <ContactsHelp c={c} horizon={h.id} />

  <div class="sec-after">

  <Slot label="근거 · 확인일" cmp="SCR-U-001">
    <p><a href={href('contact/')}>잘못된 정보 알려 주기</a></p>
  </Slot>
  </div>
</div>

<script>
  // 성폭력 단기: 답(경과시간·약물)에 따라 단계 순서만 바꿈. 숨기지 않음. 저장·전송 없음.
  const box = document.querySelector<HTMLElement>('[data-steps][data-rules]');
  if (box) {
    const rules = JSON.parse(box.dataset.rules!);
    const cards = [...box.querySelectorAll<HTMLElement>('[data-id]')];
    const base = [...cards].sort((a, b) => Number(a.dataset.order) - Number(b.dataset.order) || cards.indexOf(a) - cards.indexOf(b));
    const val = (n: string) => document.querySelector<HTMLInputElement>(`input[name="${n}"]:checked`)?.value;
    const apply = () => {
      const t = val('sv-time'), d = val('sv-drug');
      const promote: string[] = [], demote: string[] = [];
      for (const g of Object.values<any>(rules.time)) if (t && g.when.includes(t)) { promote.push(...g.promote); demote.push(...g.demote); }
      if (d && rules.drug.when.includes(d)) promote.push(...rules.drug.promote);
      const byId = (id: string) => base.find((c) => c.dataset.id === id);
      const order: HTMLElement[] = [];
      const add = (c?: HTMLElement) => { if (c && !order.includes(c)) order.push(c); };
      add(byId(rules.pinFirst));
      promote.forEach((id) => add(byId(id)));
      base.filter((c) => !demote.includes(c.dataset.id!)).forEach(add);
      base.forEach(add);
      order.forEach((c, i) => {
        box.appendChild(c);
        const label = c.querySelector<HTMLElement>('[data-step-label]');
        if (label) label.textContent = `${i + 1}단계`;
        c.querySelector<HTMLElement>('[data-now]')!.hidden = !promote.includes(c.dataset.id!);
      });
    };
    document.querySelectorAll('input[name="sv-time"], input[name="sv-drug"]').forEach((i) => i.addEventListener('change', apply));
    document.querySelector('[data-clear]')?.addEventListener('click', () => setTimeout(apply));
    window.addEventListener('pageshow', () => setTimeout(apply));
  }
</script>

<style>
  .page { padding-top: var(--space-6); max-width: 880px; }
  .kicker { font-weight: 700; margin: 0 0 var(--space-1); color: var(--color-brand-secondary-strong); }
  .lead { margin: 0 0 var(--space-5); }
  .state-draft { border-left: 4px solid var(--color-accent-text); padding: 12px 16px; margin: 0 0 var(--space-5); background: #fff; }
  .page :global(.conds) { margin: 0 0 var(--space-5); }
  .sec > h2 { margin-bottom: var(--space-5); }
  .gap { height: var(--space-6); }
  .alt-h { font-size: 20px; margin: 0 0 var(--space-3); }
  .more-help { margin: var(--space-3) 0 0; font-weight: 700; }
  .title-row { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: var(--space-3) var(--space-5); margin: 0 0 var(--space-3); }
  .title-row h1 { margin: 0; }
  /* PC: 제목이 두 줄이 되어도 버튼은 오른쪽에 */
  @media (min-width: 768px) { .title-row { display: grid; grid-template-columns: 1fr auto; align-items: end; } }
  .jump {
    display: inline-flex; align-items: center; min-height: 48px; padding: 0 20px;
    background: var(--color-emergency); color: var(--color-on-strong); font-weight: 700; text-decoration: none;
  }
  .first { margin: 0; padding-left: 1.4em; display: grid; gap: 8px; font-weight: 700; font-size: 18px; }
  .block { margin: var(--space-7) 0; }
  .block:focus { outline: none; }
  .sub { margin: -8px 0 var(--space-4); }
  .cards { display: grid; gap: var(--space-4); }
  @media (min-width: 768px) { .cards { grid-template-columns: 1fr 1fr; } }
</style>
