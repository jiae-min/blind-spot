---
// 긴급 연락처 카드 (D-024·D-025·D-027)
// 순서: 상황 제목 → 기관명 → 조건 → [번호 + 가능 시간 | 전화하기] 한 줄(세로 가운데 정렬) → 출처
// 전화 버튼은 tel: 링크(기기의 전화 앱만 열림, 자동 통화 없음). PC용 번호 복사.
import { AREA_CODES, ORGS, quickHours, telHref, type Service } from '../../data/emergency';

interface Props { s: Service; level?: 'h3' | 'h4'; uid: string; /** 번호 복사 버튼 (상세 페이지의 '긴급 연락처와 도움말'에서는 끔 — 좁은 칸에서 번호와 겹침, D-043) */ copy?: boolean }
const { s, level = 'h3', uid, copy = true } = Astro.props;
const o = ORGS[s.org];
const H = level;
const qh = quickHours(s);
---
<article class="call-card">
  {/* 제목 앞 상자: 24시간(강조색 바탕)·문자 가능 / 지역 → 운영 시간 제한(테두리) — 언제 걸 수 있는지를 상황 제목과 함께 먼저 보여 줌 (D-036) */}
  <H class="c-title">
    {qh.allDay && <span class="badge badge--24">24시간</span>}
    {qh.sms && <span class="badge">문자 가능</span>}
    {s.region && <span class="badge">{s.region}</span>}
    {!qh.allDay && <span class="badge">운영 시간 제한</span>}
    <span>{s.title}</span>
  </H>
  <p class="c-org">{o.name}</p>
  {/* 시간이 정해진 곳: 위쪽 조건 자리에 시간대를 한 줄씩 (D-029) */}
  {!qh.allDay && (
    <div class="when-box">
      <p class="when-head">{qh.text}</p>
      <ul class="notes">{qh.parts.map((t) => <li>{t}</li>)}</ul>
    </div>
  )}
  {s.notes && <ul class="notes">{s.notes.map((n) => <li>{n}</li>)}</ul>}

  {/* 번호를 전화 버튼 바로 옆에: 왼쪽 번호(24시간이면 그 표시), 오른쪽 버튼(오른손 엄지) */}
  <div class="call-row">
    <div class="num-block">
      <strong class="num">{o.number}</strong>
    </div>
    <div class="acts">
      {s.areaCode ? (
        <a class="call btn-accent" href={telHref(o.number)} aria-label={`${o.name} ${o.number} 유선전화로 전화하기`}>☎ 유선전화</a>
      ) : o.tel && (
        <a class="call btn-accent" href={telHref(o.tel)} aria-label={`${o.name} ${o.number} 전화하기`}>☎ 전화하기</a>
      )}
      {copy && <button type="button" class="copy btn-accent" data-copy-num={o.number}>번호 복사</button>}
    </div>
  </div>

  {/* 1388: 위 줄 = 유선전화, 아래 줄 = 왼쪽 안내 · 오른쪽 지역번호 + 휴대전화 */}
  {s.areaCode && (
    <div class="area" data-area={o.number}>
      <label for={`area-${uid}`}>휴대전화는 지역번호를 골라 주세요</label>
      <div class="area-row">
        <select id={`area-${uid}`} data-area-select>
          <option value="">지역번호 선택</option>
          {AREA_CODES.map(([code, name]) => <option value={code}>{name} ({code})</option>)}
        </select>
        <a class="call btn-accent" data-area-call aria-disabled="true">☎ 휴대전화로 전화하기</a>
      </div>
    </div>
  )}
  <p class="done" data-done aria-live="polite"></p>
  {/* 출처·확인일·검증 상태는 data/emergency.ts에만 둠 — 화면에는 표시하지 않음 (D-029) */}
</article>

<style>
  /* 카드 너비에 맞춰 글자·버튼을 줄임(cqi = 카드 너비의 1%). 어떤 글자도 14px 밑으로는 줄이지 않음 */
  .call-card { container-type: inline-size; border: 1px solid var(--line); background: #fff; padding: var(--space-4); display: flex; flex-direction: column; }
  .c-title { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 8px; font-size: 20px; line-height: 1.35; margin: 0 0 var(--space-1); }
  .c-org { margin: 0 0 var(--space-3); font-size: 17px; }
  .badge { flex: none; font-size: 15px; line-height: 1.6; font-weight: 700; padding: 0 8px; border: 1px solid var(--color-text); }
  /* 24시간: 강조색 중 흰 글자 대비가 충분한 진한 주황(5.2:1) */
  .badge--24 { background: var(--color-accent-text); border-color: var(--color-accent-text); color: var(--color-on-strong); }
  /* 카드 본문 17px (D-030): 기관명·조건·전화 가능 시간 제목과 항목 모두 같은 크기 */
  .notes { list-style: none; margin: 0 0 var(--space-3); padding: 0; font-size: 17px; }
  .when-head { margin: 0 0 2px; font-size: 17px; font-weight: 700; color: var(--color-brand-secondary-strong); }
  .when-box .notes { margin-bottom: var(--space-2); }
  .notes li { position: relative; padding: 3px 0 3px 16px; }
  .notes li::before { content: ''; position: absolute; left: 2px; top: 14px; width: 5px; height: 5px; background: var(--color-text); }

  .call-row {
    display: flex; align-items: center; justify-content: space-between; gap: 10px;
    margin-top: auto; padding-top: var(--space-3); border-top: 1px dashed var(--line);
  }
  .num-block { display: flex; flex-direction: column; min-width: 0; }
  .num { font-size: clamp(18px, 7.5cqi, 24px); line-height: 1.2; letter-spacing: .01em; white-space: nowrap; }
  /* 번호 아래 보조 문구: 번호보다 확실히 작고 가볍게 (사이트 최소 14px) */
  .acts { display: flex; align-items: center; gap: 6px; flex: none; }
  .call {
    display: inline-flex; align-items: center; justify-content: center; min-height: 48px; white-space: nowrap;
    padding: 0 clamp(10px, 4.5cqi, 18px); font-size: clamp(14px, 4.6cqi, 16px);
    text-decoration: none; font-weight: 700;
    background: var(--color-emergency); color: var(--color-on-strong); border: 1px solid var(--color-emergency);
  }
  .call[aria-disabled='true'] { opacity: .45; pointer-events: none; }
  .copy {
    min-height: 48px; padding: 0 clamp(10px, 3.5cqi, 16px); font-size: clamp(14px, 4.2cqi, 16px); white-space: nowrap;
    border: 1px solid var(--color-text); background: none; font-family: inherit; font-weight: 700; color: inherit; cursor: pointer;
  }
  /* 번호 복사는 PC(마우스)에서만 */
  @media (hover: none), (pointer: coarse) { .copy { display: none; } }
  .done { margin: 4px 0 0; font-size: 15px; font-weight: 700; text-align: right; }
  .done:empty { display: none; }

  .area { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 12px; margin-top: var(--space-3); padding-top: var(--space-3); border-top: 1px dashed var(--line); }
  .area label { flex: 1 1 10em; font-size: 17px; font-weight: 700; }
  /* 줄이 나뉘어도 버튼은 카드 오른쪽 끝에 */
  .area-row { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 8px; margin-left: auto; }
  .area select { min-height: 48px; padding: 0 12px; font: inherit; font-size: 17px; border: 1px solid var(--color-text); border-radius: 0; background: #fff; color: inherit; }
</style>
