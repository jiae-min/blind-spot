---
// 가까운 기관 목록 (CMP-CARD-01). 지역을 고르면 그 시·도의 기관만, 같은 구·시에 있는 기관을 맨 위로.
// 선택값은 화면 안에서만 쓰고 저장·URL·전송 없음 (EVT-SAFE-INPUT). 기관 자료가 없으면 자리만 표시.
import Slot from './Slot.astro';
import { resourcesFor } from '../../data/content';
import type { CaseId } from '../../data/cases';
interface Props { caseId: CaseId }
const { caseId } = Astro.props;
const items = resourcesFor(caseId).sort((a, b) => (a.sido === b.sido ? 0 : a.sido === '서울' ? -1 : 1));
const tel = (p: string) => `tel:${p.replace(/[^0-9]/g, '')}`;
---
{items.length === 0 ? (
  <Slot label="가까운 기관" cmp="CMP-CARD-01" note="위에서 고른 지역의 기관을 먼저 보여 줌. 이 상황의 기관 자료(주소·전화·운영시간)는 아직 수집·검증 전." />
) : (
  <div class="centers" data-centers>
    <p class="hint" data-hint>위에서 지역을 고르면 그 지역의 센터만 보여 드려요.</p>
    <ul>
      {items.map((r) => (
        <li class="center" data-sido={r.sido} data-sigungu={r.sigungu}>
          <p class="tags">
            <span class="near" data-near hidden>같은 {r.sigungu.endsWith('구') ? '구' : '시·군'}에 있어요</span>
            {r.child && <span class="child">아동 센터</span>}
            {r.draft && <span class="draft-tag">검증 전 초안</span>}
          </p>
          <h3>{r.name}</h3>
          <p class="where">{r.address ?? `${r.sido} ${r.sigungu}`}</p>
          <p class="actions">
            {r.phone && <a class="call btn-accent" href={tel(r.phone)}>☎ {r.phone}</a>}
            {r.homepage && <a class="home" href={r.homepage} target="_blank" rel="noopener noreferrer">홈페이지<span class="sr-only"> (새 창)</span> ↗</a>}
          </p>
          <p class="src">근거 <a href={r.sourceUrl} target="_blank" rel="noopener noreferrer">해바라기센터 센터 안내<span class="sr-only"> (새 창)</span> ↗</a> · 확인일 {r.checkedAt}</p>
        </li>
      ))}
    </ul>
    <p class="none" data-none hidden>고른 지역의 센터 자료가 아직 없어요. 국번 없이 1366에 전화하면 가까운 기관으로 연결을 요청할 수 있어요.</p>
    <p class="note">센터마다 맡는 지역과 이용 가능한 서비스가 다를 수 있어요. 어느 센터로 가야 할지는 전화로 먼저 확인해 주세요.</p>
  </div>
)}

<script>
  document.querySelectorAll<HTMLElement>('[data-centers]').forEach((box) => {
    const list = box.querySelector('ul')!;
    const cards = [...list.querySelectorAll<HTMLElement>('.center')];
    const hint = box.querySelector<HTMLElement>('[data-hint]')!;
    const none = box.querySelector<HTMLElement>('[data-none]')!;
    const checked = (sel: string) => document.querySelector<HTMLInputElement>(`${sel}:checked`)?.value;
    const apply = () => {
      const sidoVal = checked('input[name$="-region"]');
      const sido = sidoVal === 'seoul' ? '서울' : sidoVal === 'gyeonggi' ? '경기' : null;
      const sigungu = sido ? checked(sido === '서울' ? 'input[name$="-region-seoul"]' : 'input[name$="-region-gyeonggi"]') : undefined;
      let shown = 0;
      const order = [...cards].sort((a, b) => Number(b.dataset.sigungu === sigungu) - Number(a.dataset.sigungu === sigungu));
      order.forEach((c) => {
        list.appendChild(c);
        const visible = !sido || c.dataset.sido === sido;
        c.hidden = !visible;
        if (visible) shown++;
        c.querySelector<HTMLElement>('[data-near]')!.hidden = !(sigungu && c.dataset.sigungu === sigungu);
      });
      hint.hidden = !!sido;
      none.hidden = shown > 0;
    };
    document.addEventListener('change', (e) => {
      if ((e.target as HTMLInputElement).name?.includes('-region')) apply();
    });
    document.querySelectorAll('[data-clear]').forEach((b) => b.addEventListener('click', () => setTimeout(apply)));
    window.addEventListener('pageshow', () => setTimeout(apply));
  });
</script>

<style>
  .hint, .note { font-size: 15px; margin: 0 0 var(--space-3); color: rgba(51, 56, 35, .85); }
  .note { margin: var(--space-3) 0 0; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-3); }
  @media (min-width: 768px) { ul { grid-template-columns: 1fr 1fr; } }
  .center { display: flex; flex-direction: column; border: 1px solid var(--color-text); padding: var(--space-4); background: var(--color-canvas); }
  .center[hidden] { display: none; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 6px; }
  .tags:not(:has(span:not([hidden]))) { display: none; }
  .near, .child, .draft-tag { padding: 2px 8px; font-size: 12px; font-weight: 700; color: var(--color-on-strong); }
  .near { background: var(--color-brand-secondary-strong); }
  .near[hidden] { display: none; }
  .child { background: var(--color-text); }
  .draft-tag { background: var(--color-accent-text); }
  h3 { font-size: 18px; margin: 0 0 4px; }
  .where { margin: 0 0 var(--space-3); font-size: 15px; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px; margin: 0 0 var(--space-2); }
  .call {
    display: inline-flex; align-items: center; min-height: 44px; padding: 0 16px; border: 1px solid var(--color-emergency);
    background: var(--color-emergency); color: var(--color-on-strong); font-weight: 700; text-decoration: none;
  }
  .home { font-weight: 600; }
  .src { margin: auto 0 0; padding-top: var(--space-2); font-size: 13px; color: rgba(51, 56, 35, .75); text-align: right; }
  .none { padding: 10px 12px; background: rgba(123, 158, 137, .12); font-weight: 600; }
</style>
