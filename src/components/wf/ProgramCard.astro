---
// CMP-CARD-01 제도·기관 안내 카드 자리. CMP-STATUS-01(비용)·CMP-STATUS-02(자격/접수)는 섞지 않고 따로 표기.
// 비용은 자료가 없으면 표준 문구 기본값 '비용 발생 여부 확인 필요' (2.1 §6).
interface Props { n: number; contact?: boolean }
const { n, contact = false } = Astro.props;
---
<article class="card">
  <h3>[제도·기관 이름 {n}]</h3>
  <dl class="chips">
    <div><dt>신청 자격</dt><dd>[예비 자격 상태]</dd></div>
    <div><dt>접수</dt><dd>[접수 상태]</dd></div>
    <div><dt>비용</dt><dd>비용 발생 여부 확인 필요</dd></div>
  </dl>
  <p>[한두 줄 설명 자리 — QA 승인 원고]</p>
  {contact && <p class="contact"><span class="fake-btn" aria-hidden="true">☎ [전화 걸기]</span> <span>[운영 시간 자리]</span></p>}
  <p class="meta">근거 [출처] · 확인일 [YYYY-MM-DD]</p>
  <span class="fake-link">[공식 안내·신청 링크] ↗</span>
</article>

<style>
  .card { border: 1px solid var(--line); padding: var(--space-4); background: var(--color-canvas); }
  h3 { font-size: 20px; margin-bottom: var(--space-3); }
  /* 신청 자격·접수·비용: 항목마다 한 줄, 하나의 박스 */
  .chips { margin: 0 0 var(--space-3); border: 1px solid var(--color-text); }
  .chips div { display: grid; grid-template-columns: 92px 1fr; align-items: center; min-height: 44px; font-size: 15px; }
  .chips div + div { border-top: 1px solid var(--line); }
  dt { font-weight: 700; padding: 8px 12px; align-self: stretch; display: flex; align-items: center; border-right: 1px solid var(--line); background: rgba(123, 158, 137, .1); }
  dd { padding: 8px 12px; }
  dd { margin: 0; }
  p { margin: 0 0 var(--space-3); }
  .contact { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
  .fake-btn { display: inline-flex; align-items: center; min-height: 44px; padding: 0 16px; background: var(--color-emergency); color: var(--color-on-strong); font-weight: 700; }
  .meta { font-size: 15px; color: rgba(51, 56, 35, .8); }
  .fake-link { font-weight: 700; text-decoration: underline dashed; }
</style>
