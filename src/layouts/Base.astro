---
// 글꼴: 휴대폰·태블릿은 기기 기본 글꼴(D-031), PC(폭 1025px 이상 + 마우스)만 Pretendard(D-042, 사이트에 직접 포함). 로고만 Kanit 모양 SVG.
import { LOGO } from '../data/logo';
import '../styles/pretendard.css';
import '../styles/global.css';
import { CASES, HORIZONS, href } from '../data/cases';
import { INFO_PAGES, DISCLAIMER } from '../data/info';
import { SHOW_DRAFTS } from '../data/content';

interface Props {
  title: string;
  description?: string;
  /** 폭력 관련 페이지: 탭 제목·공유 미리보기를 중립 문구로, 빠르게 나가기 노출 (D-028) */
  sensitive?: boolean;
  /** 빠르게 나가기만 필요할 때(홈·모든 케이스 페이지). 기본은 sensitive와 같음 */
  quickExit?: boolean;
  /** 검색 노출 허용 (v4 3.4 §7, D-041): 운영자가 확인·승인한 내용만 있는 페이지. 미승인·시안·제작 중 페이지와 미리보기 빌드는 늘 차단 */
  index?: boolean;
}
const { title, description = '필요한 도움을 바로 찾을 수 있도록 안내할게요.', sensitive = false, quickExit = sensitive, index = false } = Astro.props;
const indexable = index && !SHOW_DRAFTS;
const canonical = indexable && Astro.site ? new URL(Astro.url.pathname, Astro.site).href : null;
// 폭력 관련 페이지는 탭·기록·공유 미리보기에 무슨 내용인지 드러나지 않게 (URL은 D-004대로 유지)
const NEUTRAL_TITLE = 'blind spot · 안내';
const pageTitle = sensitive ? NEUTRAL_TITLE : `${title} | blind spot`;
const metaDesc = sensitive ? '필요한 도움을 안내해요.' : description;
// 빠르게 나가기 이동처 (D-007, 임시)
const EXIT_URL = 'https://www.naver.com/';
// 푸터 링크 묶음 (칸마다 작은 영문 머리말). 칸마다 2개씩 — 소개 둘은 로고 칸 아래로
const BRAND_LINKS = ['about', 'safe-browsing'];
const FOOT_GROUPS = [
  { head: 'About', title: '서비스 정보', ids: ['verification', 'corrections'] },
  { head: 'Contact', title: '문의', ids: ['contact'] },
  { head: 'Legal', title: '약관·개인정보', ids: ['privacy', 'terms'] },
];
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* 검색 노출: 승인된 내용만 있는 페이지만 허용, 나머지(미승인·시안·제작 중·미리보기)는 차단 (v4 3.4 §7) */}
    <meta name="robots" content={indexable ? 'index, follow' : 'noindex, nofollow'} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta http-equiv="Content-Security-Policy" content={`default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ${import.meta.env.DEV ? "'self' ws:" : "'none'"}; object-src 'none'; base-uri 'self'; form-action 'none'`} />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDesc} />
    {/* 공유 미리보기(메신저 등) — 폭력 관련 페이지는 중립 문구 */}
    <meta property="og:site_name" content="blind spot" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDesc} />
  </head>
  <body class:list={{ 'has-exit-bar': quickExit }}>
    {/* 로고 모양 한 번만 정의하고 헤더·푸터에서 재사용 (D-031) */}
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false"><symbol id="logo-glyphs" viewBox={`0 0 ${LOGO.w} ${LOGO.h}`}><path d={LOGO.d} fill="currentColor" /></symbol></svg>
    <a class="skip" href="#main">본문 바로가기</a>
    <header class="site-header">
      <div class="bar">
        <a class="logo" href={href()} aria-label="blind spot 홈">
          <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true"><path d="M11 1 21 11 11 21 1 11Z" fill="none" stroke="currentColor" stroke-width="2.5"/></svg>
          <svg class="logo-text" viewBox={`0 0 ${LOGO.w} ${LOGO.h}`} aria-hidden="true"><use href="#logo-glyphs" /></svg>
        </a>
        {/* PC 메인 메뉴: 칸마다 케이스, 마우스·키보드로 단기/장기 하위 메뉴 (heronaiapp.com 방식) */}
        <nav class="main-nav" aria-label="상황 메뉴">
          <ul>
            {CASES.map((c) => (
              <li class="nav-item">
                <a class="cell nav-cell btn-accent" href={href(`cases/${c.id}/`)}>{c.label}<span class="corner-mark" aria-hidden="true"></span></a>
                <ul class="nav-sub">
                  {HORIZONS.map((h) => <li><a class="btn-accent" href={href(`cases/${c.id}/${h.id}/`)}>{h.title} <span class="mono">{h.sub}</span></a></li>)}
                </ul>
              </li>
            ))}
          </ul>
        </nav>
        <div class="actions">
          {quickExit && <a class="cell exit" href={EXIT_URL} data-quick-exit>빠르게 나가기</a>}
          <a class="cell emergency btn-accent" href={href('help/')}>긴급 도움 <span class="arrow" aria-hidden="true">→</span></a>
          {/* 모바일·태블릿: 같은 메뉴를 버거 안에. <details>라 JS 없이 동작 */}
          <details class="menu">
            <summary class="cell btn-accent" aria-label="상황 메뉴 열기"><span class="burger" aria-hidden="true"><i></i><i></i><i></i></span></summary>
            <nav aria-label="상황 메뉴">
              <ul>
                {CASES.map((c) => (
                  <li>
                    <a class="m-case btn-accent" href={href(`cases/${c.id}/`)}>{c.label}</a>
                    <ul class="m-sub">
                      {HORIZONS.map((h) => <li><a class="btn-accent" href={href(`cases/${c.id}/${h.id}/`)}>{h.title} <span>({h.sub})</span></a></li>)}
                    </ul>
                  </li>
                ))}
                <li class="m-help"><a class="m-case btn-accent" href={href('help/')}>긴급 도움</a></li>
              </ul>
            </nav>
          </details>
        </div>
      </div>
    </header>
    {SHOW_DRAFTS && (
      <p class="draft-banner" role="note">미리보기 · 검증 전 초안이 포함돼 있어요. 실제로 이용하기 전에 해당 기관에 꼭 확인해 주세요.</p>
    )}
    {quickExit && (
      <p class="safety-strip">
        <span>Shift 키를 3번 누르면 바로 나가요.</span>
        <a href={href('safe-browsing/')}>흔적 남기지 않고 보는 법 알아보기 <span aria-hidden="true">→</span></a>
      </p>
    )}
    <main id="main">
      <slot />
    </main>
    {/* 푸터: 가는 선으로 나뉜 칸 (heronaiapp.com 방식) */}
    <footer class="site-footer">
      <div class="foot-grid">
        <nav class="foot-cell foot-brand" aria-label="서비스 소개">
          <p class="foot-logo"><svg class="logo-text" viewBox={`0 0 ${LOGO.w} ${LOGO.h}`} role="img" aria-label="blind spot"><use href="#logo-glyphs" /></svg></p>
          <ul>
            {BRAND_LINKS.map((id) => {
              const p = INFO_PAGES.find((x) => x.id === id)!;
              return <li><a class="foot-link btn-accent" href={href(`${p.id}/`)}>{p.title} <span class="arrow" aria-hidden="true">→</span></a></li>;
            })}
          </ul>
        </nav>
        {FOOT_GROUPS.map((g) => (
          <nav class="foot-cell" aria-label={g.title}>
            <p class="foot-head mono">{g.head}</p>
            <ul>
              {g.ids.map((id) => {
                const p = INFO_PAGES.find((x) => x.id === id)!;
                return <li><a class="foot-link btn-accent" href={href(`${p.id}/`)}>{p.title} <span class="arrow" aria-hidden="true">→</span></a></li>;
              })}
            </ul>
          </nav>
        ))}
      </div>
      {/* 법적 책임 한계 고지 — 모든 페이지 (D-023) */}
      <section class="foot-legal" aria-label="법적 책임 한계 고지">
        <p class="foot-head mono">Disclaimer</p>
        <p class="legal-title">법적 책임 한계 고지</p>
        {DISCLAIMER.map((t) => <p class="legal-text">{t}</p>)}
      </section>
    </footer>
    <script is:inline>
      // 상황 메뉴: Esc·바깥 클릭으로 닫기 (JS가 없어도 메뉴 자체는 동작)
      (function () {
        var m = document.querySelector('details.menu');
        if (!m) return;
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && m.open) { m.open = false; m.querySelector('summary').focus(); }
        });
        document.addEventListener('click', function (e) { if (m.open && !m.contains(e.target)) m.open = false; });
      })();
    </script>
    {quickExit && (
      <>
        {/* 모바일: 화면 아래 고정 (엄지가 닿는 자리) */}
        <div class="exit-bar">
          <a class="exit-bar-btn" href={EXIT_URL} data-quick-exit>빠르게 나가기</a>
          <a class="exit-bar-help" href={href('safe-browsing/')}>흔적 남기지<br />않고 보는 법</a>
        </div>
        <script is:inline define:vars={{ exitUrl: EXIT_URL }}>
          // 빠르게 나가기 (D-028, GOV.UK 방식): 화면을 먼저 즉시 가린 뒤 현재 페이지를 기록에서 대체하며 이동
          // (뒤로 가기로 바로 돌아오지 않게). 방문 기록 삭제는 아님.
          // 단축키는 Shift 3번 — Esc는 줌 화면·메뉴 닫기에 쓰고, 다른 기능과 겹치기 쉬워서 쓰지 않음.
          (function () {
            var leaving = false;
            function leave() {
              if (leaving) return;
              leaving = true;
              var cover = document.createElement('div');
              cover.setAttribute('style', 'position:fixed;inset:0;z-index:2147483647;background:#fbfaf8');
              document.body.appendChild(cover);
              document.title = '';
              location.replace(exitUrl);
            }
            document.querySelectorAll('[data-quick-exit]').forEach(function (a) {
              a.addEventListener('click', function (e) { e.preventDefault(); leave(); });
            });
            var count = 0, last = 0;
            document.addEventListener('keydown', function (e) {
              if (e.key !== 'Shift') { count = 0; return; }
              if (e.repeat) return;
              var now = Date.now();
              count = now - last < 1000 ? count + 1 : 1; // 누름 사이 1초 안
              last = now;
              if (count >= 3) leave();
            });
          })();
        </script>
      </>
    )}
  </body>
</html>

<style>
  .skip { position: absolute; left: -9999px; top: 8px; background: var(--color-text); color: var(--color-on-strong); padding: 8px 12px; z-index: 10; }
  .skip:focus { left: 8px; }
  /* 헤더: 가는 선으로 나뉜 칸 (heronaiapp.com 스타일) */
  .site-header { border-bottom: 1px solid var(--line); background: var(--color-canvas); position: sticky; top: 0; z-index: 100; } /* 맨 위: 메뉴 */
  .bar { display: flex; align-items: stretch; height: 56px; }
  .logo {
    display: inline-flex; align-items: center; gap: 10px; padding: 0 var(--space-4); margin-right: auto;
    font-size: 22px; text-decoration: none;
  }
  /* 로고 글자: Kanit 모양의 SVG(D-031). 높이 1.495em = 글꼴의 ascent~descent 높이라 글자로 쓸 때와 크기가 같음 */
  .logo-text { display: block; height: 1.495em; width: auto; }
  @media (min-width: 768px) { .logo { padding: 0 var(--space-6); } }
  .actions { display: flex; align-items: stretch; }
  .cell {
    font-size: 16px;
    display: inline-flex; align-items: center; justify-content: center; gap: 8px; height: 100%; padding: 0 22px;
    border-left: 1px solid var(--line); font-weight: 700; text-decoration: none; cursor: pointer;
  }
  .emergency { background: var(--color-emergency); color: var(--color-on-strong); border-left-color: var(--color-emergency); }
  .arrow { font-weight: 500; }
  /* 빠르게 나가기: 다른 메뉴와 구별되도록 강조색 바탕, 호버 시 기본 글자색 바탕 */
  .exit {
    background: var(--color-accent); color: var(--color-on-strong); border-left-color: var(--color-accent);
    transition: background-color var(--t) var(--ease), border-color var(--t) var(--ease);
  }
  .exit:hover, .exit:focus-visible { background: var(--color-text); border-left-color: var(--color-text); }

  /* 미리보기 빌드에서만: 검증 전 초안 안내 띠 */
  .draft-banner { margin: 0; padding: 10px var(--space-4); background: var(--color-accent-text); color: var(--color-on-strong); font-weight: 700; font-size: 15px; text-align: center; }

  /* PC 메인 메뉴 */
  .main-nav { display: none; }
  .main-nav > ul { display: flex; height: 100%; list-style: none; margin: 0; padding: 0; }
  .nav-item { position: relative; }
  .nav-cell { position: relative; justify-content: flex-start; align-items: flex-start; min-width: 132px; padding: 10px 16px; }
  /* 하위 메뉴가 있음을 알리는 오른쪽 아래 작은 삼각 표시 */
  .corner-mark { position: absolute; right: 5px; bottom: 5px; width: 0; height: 0; border-left: 6px solid transparent; border-bottom: 6px solid currentColor; opacity: .55; }
  .nav-sub {
    position: absolute; left: 0; top: 100%; min-width: 100%; list-style: none; margin: 0; padding: 0; z-index: 20;
    background: var(--color-canvas); border: 1px solid var(--line); border-top: 0;
    visibility: hidden; opacity: 0; clip-path: inset(0 0 100% 0);
    transition: clip-path var(--t) var(--ease), opacity var(--t) var(--ease), visibility 0s linear var(--t);
  }
  .nav-item:hover .nav-sub, .nav-item:focus-within .nav-sub {
    visibility: visible; opacity: 1; clip-path: inset(0 0 0 0); transition-delay: 0s;
  }
  .nav-sub li + li { border-top: 1px solid var(--line); }
  .nav-sub a { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 48px; padding: 0 16px; white-space: nowrap; font-weight: 500; text-decoration: none; }
  .nav-sub .mono { font-size: 11px; }
  /* 케이스 5개 + 빠르게 나가기 + 긴급 도움이 한 줄에 들어가는 폭부터 펼친 메뉴, 그 아래는 버거 */
  @media (min-width: 1200px) {
    .main-nav { display: block; }
    .menu { display: none !important; }
  }

  /* 모바일·태블릿 버거 메뉴 */
  .menu { position: relative; display: flex; }
  .menu summary { width: 64px; padding: 0; list-style: none; }
  .menu summary::-webkit-details-marker { display: none; }
  .burger { display: grid; gap: 5px; width: 20px; }
  .burger i { display: block; height: 2px; background: currentColor; transition: transform var(--t) var(--ease), opacity var(--t); }
  .menu[open] .burger i:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .menu[open] .burger i:nth-child(2) { opacity: 0; }
  .menu[open] .burger i:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  .menu nav {
    position: absolute; right: 0; top: 100%; min-width: 280px; max-height: calc(100vh - 70px); overflow-y: auto; z-index: 20;
    background: var(--color-canvas); border: 1px solid var(--line); border-top: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .menu[open] nav { animation: menu-in var(--t) var(--ease); }
  }
  @keyframes menu-in { from { clip-path: inset(0 0 100% 0); } to { clip-path: inset(0 0 0 0); } }
  .menu ul { list-style: none; margin: 0; padding: 0; }
  .menu li + li { border-top: 1px solid var(--line); }
  .menu a { display: flex; align-items: center; min-height: 48px; padding: 0 18px; font-weight: 700; text-decoration: none; }
  .menu .m-case { font-size: 17px; }
  .menu .m-sub { border-top: 1px solid var(--line); }
  .menu .m-sub li + li { border-top: 1px dashed var(--line); }
  .menu .m-sub a { font-weight: 500; min-height: 42px; padding-left: 34px; }
  .menu .m-sub span { font-size: 13px; margin-left: 6px; }

  /* 푸터 */
  .site-footer { margin-top: var(--space-8); border-top: 1px solid var(--line); }
  .foot-grid { display: grid; grid-template-columns: 1fr; }
  .foot-cell { padding: var(--space-5) var(--space-4); border-top: 1px solid var(--line); }
  .foot-cell:first-child { border-top: 0; }
  .foot-cell p { margin: 0; }
  .foot-logo { font-size: 28px; line-height: 1; margin-bottom: var(--space-3) !important; }
  .foot-head { margin-bottom: var(--space-3) !important; color: var(--color-accent-text); }
  .foot-cell ul { list-style: none; margin: 0; padding: 0; }
  .foot-link { display: flex; align-items: center; justify-content: space-between; min-height: 44px; padding: 0 10px; margin: 0 -10px; font-weight: 500; text-decoration: none; }
  .foot-legal { border-top: 1px solid var(--line); padding: var(--space-5) var(--space-4) var(--space-6); }
  .foot-legal p { margin: 0; }
  .legal-title { font-weight: 700; margin-bottom: var(--space-2) !important; }
  .legal-text { font-size: 14px; line-height: 1.7; color: rgba(51, 56, 35, .8); }
  @media (min-width: 768px) {
    .foot-legal { padding: var(--space-5) var(--space-6) var(--space-6); }
    .foot-grid { grid-template-columns: 2fr 1fr 1fr 1fr; }
    .foot-cell { border-top: 0; border-left: 1px solid var(--line); padding: var(--space-5) var(--space-5) var(--space-6); }
    .foot-cell:first-child { border-left: 0; padding-left: var(--space-6); }
    /* 칸끼리 줄 맞춤: 1줄 = 로고·머리말(세로 가운데), 2줄 = 링크 목록(윗줄 시작점 같게) */
    .foot-grid { grid-template-rows: auto auto; }
    .foot-cell { display: grid; grid-row: span 2; grid-template-rows: subgrid; align-content: start; }
    .foot-logo, .foot-head { align-self: center; }
  }

  /* 빠르게 나가기 안내 띠 (PC·태블릿): 메뉴 바로 아래, 강조색 바탕·가운데 정렬 이벤트 바 (D-029) */
  .safety-strip {
    display: flex; justify-content: center; align-items: center; flex-wrap: wrap; gap: 4px 16px; margin: 0;
    padding: 10px var(--space-6); background: var(--color-accent); color: var(--color-on-strong);
    font-size: 15px; font-weight: 700; text-align: center;
  }
  .safety-strip a { color: var(--color-on-strong); text-decoration: underline; text-underline-offset: 3px; }
  .safety-strip a:hover, .safety-strip a:focus-visible { color: var(--color-text); }
  .safety-strip a:focus-visible { outline-color: var(--color-text); }
  /* 모바일 아래 고정 막대 — 768px 미만에서만, 헤더의 빠르게 나가기는 숨김 */
  .exit-bar { display: none; }
  @media (max-width: 767px) {
    .exit { display: none; }
    .safety-strip { display: none; }
    .exit-bar {
      display: flex; position: fixed; left: 0; right: 0; bottom: 0; z-index: 200;
      border-top: 1px solid var(--color-text); background: var(--color-canvas);
      padding-bottom: env(safe-area-inset-bottom);
    }
    .exit-bar-btn {
      flex: 1; display: flex; align-items: center; justify-content: center; min-height: 56px;
      background: var(--color-accent); color: var(--color-on-strong); font-size: 18px; font-weight: 800; text-decoration: none;
    }
    .exit-bar-btn:active { background: var(--color-text); }
    .exit-bar-help {
      flex: none; display: flex; align-items: center; justify-content: center; padding: 0 14px; text-align: center;
      font-size: 14px; line-height: 1.3; font-weight: 700; text-decoration: none; border-left: 1px solid var(--line);
    }
    :global(body.has-exit-bar) { padding-bottom: calc(57px + env(safe-area-inset-bottom)); }
  }

  /* 좁은 화면: 로고 글자를 숨겨 칸 셋이 한 줄에 들어가게 */
  @media (max-width: 420px) {
    .logo .logo-text { display: none; }
    .cell { padding: 0 12px; font-size: 15px; }
