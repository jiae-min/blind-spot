---
// 운영자 검수 페이지 /admin/ (D-032)
// 로컬 개발(npm run dev)과 미리보기 빌드에서만 만들어짐. 공개 빌드에는 이 페이지가 없음(초안 제목이 들어 있어서).
// 다른 페이지에 아무것도 더하지 않아 사이트 속도에 영향 없음.
import Base from '../layouts/Base.astro';
import { CONTENT, SHOW_DRAFTS, isStale, type ContentItem } from '../data/content';
import { CASES, HORIZONS, href } from '../data/cases';
import { ORGS } from '../data/emergency';
import { TODOS } from '../data/admin-todo';

export function getStaticPaths() {
  return import.meta.env.DEV || SHOW_DRAFTS ? [{ params: { admin: 'admin' } }] : [];
}

const today = new Date().toISOString().slice(0, 10);
const SOON = 14;              // 다음 확인일 임박 기준(일)
const CONTACT_REVIEW = 90;    // 긴급 연락처 재확인 주기(일) — 운영 정책 확정 전 기본값
const dayDiff = (a: string, b: string) => Math.round((Date.parse(a) - Date.parse(b)) / 86400000);
const addDays = (d: string, n: number) => new Date(Date.parse(d) + n * 86400000).toISOString().slice(0, 10);
const caseLabel = (i: ContentItem) => i.cases.map((c) => CASES.find((x) => x.id === c)?.label ?? c).join('·');
const horizonLabel = (h: string) => HORIZONS.find((x) => x.id === h)?.sub ?? h;

// 1) 공개 안내: 확인 기한
const published = CONTENT.filter((i) => !i.draft);
const rowState = (i: ContentItem) => {
  if (!i.nextCheck) return { cls: 'warn', text: '다음 확인일 없음' };
  const left = dayDiff(i.nextCheck, today);
  if (left < 0) return { cls: 'bad', text: `${-left}일 지남` };
  if (left <= SOON) return { cls: 'warn', text: `${left}일 남음` };
  return { cls: 'ok', text: `${left}일 남음` };
};
// 2) 검토 대기: 초안 + 편집안 승인 대기
const drafts = CONTENT.filter((i) => i.draft);
// 3) 긴급 연락처
const contacts = Object.values(ORGS).map((o) => {
  const next = addDays(o.checked, CONTACT_REVIEW);
  const left = dayDiff(next, today);
  const issues = [o.status === 'needs-check' && '일부 확인 필요', !o.source.url && '출처 주소 없음'].filter(Boolean) as string[];
  return { o, next, left, issues };
});
const todos = TODOS.filter((t) => !t.done);

const n = {
  published: published.length,
  stale: published.filter((i) => isStale(i, today)).length,
  soon: published.filter((i) => i.nextCheck && !isStale(i, today) && dayDiff(i.nextCheck, today) <= SOON).length,
  drafts: drafts.length,
  contactIssues: contacts.filter((c) => c.issues.length || c.left < 0).length,
  todos: todos.length,
};
---
<Base title="검수 현황">
  <div class="wrap page">
    <section class="sec tick opening">
      <p class="kicker">운영자용 · 공개 빌드에는 없는 페이지</p>
      <h1>검수 현황</h1>
      <p class="lead desc">기준일 {today} (이 페이지를 만든 시각). 빨간 줄부터 확인해 주세요. 원고는 저장소의 <code>content/</code> 폴더에서 고쳐요.</p>
      <ul class="tiles">
        <li class:list={{ bad: n.stale > 0 }}><strong>{n.stale}</strong><span>확인 기한 지남</span></li>
        <li class:list={{ warn: n.soon > 0 }}><strong>{n.soon}</strong><span>{SOON}일 안에 기한</span></li>
        <li class:list={{ warn: n.drafts > 0 }}><strong>{n.drafts}</strong><span>승인 대기 원고</span></li>
        <li class:list={{ warn: n.contactIssues > 0 }}><strong>{n.contactIssues}</strong><span>연락처 확인 필요</span></li>
        <li class:list={{ warn: n.todos > 0 }}><strong>{n.todos}</strong><span>결정 대기</span></li>
        <li><strong>{n.published}</strong><span>공개 중인 안내</span></li>
      </ul>
      {!SHOW_DRAFTS && <p class="note">로컬 개발 화면이라 승인 대기 원고가 빠져 있어요. 전체를 보려면 <code>npm run dev:preview</code>로 여세요.</p>}
    </section>

    <section class="sec tick">
      <h2>공개 중인 안내 — 확인 기한</h2>
      {published.length === 0 ? <p class="empty">아직 공개된 안내가 없어요. 승인한 항목을 <code>content/domestic-violence.json</code>에 넣으면 여기에 나와요.</p> : (
        <div class="scroll"><table>
          <thead><tr><th>상태</th><th>케이스</th><th>구분</th><th>제목</th><th>확인일</th><th>다음 확인일</th><th>파일</th></tr></thead>
          <tbody>
            {published.sort((a, b) => (a.nextCheck ?? '').localeCompare(b.nextCheck ?? '')).map((i) => { const s = rowState(i); return (
              <tr class={s.cls}>
                <td class="state">{s.text}</td><td>{caseLabel(i)}</td><td>{horizonLabel(i.horizon)} · {i.kind === 'guide' ? '단계' : '질문'}</td>
                <td><a href={href(`cases/${i.cases[0]}/${i.horizon}/`)}>{i.title}</a><span class="id">{i.id}</span></td>
                <td>{i.checkedAt ?? '—'}</td><td>{i.nextCheck ?? '—'}</td><td class="file">{i.file}</td>
              </tr>
            ); })}
          </tbody>
        </table></div>
      )}
    </section>

    <section class="sec tick">
      <h2>승인 대기 원고</h2>
      <p class="desc sub">검증·승인 전이라 공개 사이트에는 나오지 않아요. 승인하면 <code>content/domestic-violence.json</code>으로 옮기고 승인자·승인일을 채워 주세요.</p>
      {drafts.length === 0 ? <p class="empty">{SHOW_DRAFTS ? '승인 대기 원고가 없어요.' : '미리보기 모드에서만 보여요.'}</p> : (
        <div class="scroll"><table>
          <thead><tr><th>케이스</th><th>구분</th><th>제목</th><th>위험도</th><th>근거</th><th>편집안</th><th>파일</th></tr></thead>
          <tbody>
            {drafts.map((i) => (
              <tr>
                <td>{caseLabel(i)}</td><td>{horizonLabel(i.horizon)} · {i.kind === 'guide' ? '단계' : '질문'}</td>
                <td><a href={href(`cases/${i.cases[0]}/${i.horizon}/`)}>{i.title}</a><span class="id">{i.id}</span></td>
                <td>{i.risk ?? '—'}</td><td>{i.evidence.length}건 · {i.checkedAt ?? '확인일 없음'}</td>
                <td>{i.editorial ? (i.editorial.approved ? '승인됨' : '판정 대기') : '—'}</td><td class="file">{i.file}</td>
              </tr>
            ))}
          </tbody>
        </table></div>
      )}
    </section>

    <section class="sec tick">
      <h2>긴급 연락처</h2>
      <p class="desc sub">재확인 주기는 임시로 {CONTACT_REVIEW}일이에요. 연락처는 <code>src/data/emergency.ts</code>에서 고쳐요.</p>
      <div class="scroll"><table>
        <thead><tr><th>상태</th><th>기관</th><th>번호</th><th>확인일</th><th>다음 확인일</th><th>확인할 점</th></tr></thead>
        <tbody>
          {contacts.sort((a, b) => a.left - b.left).map(({ o, next, left, issues }) => (
            <tr class={left < 0 ? 'bad' : issues.length || left <= SOON ? 'warn' : 'ok'}>
              <td class="state">{left < 0 ? `${-left}일 지남` : `${left}일 남음`}</td><td>{o.name}</td><td>{o.number}</td>
              <td>{o.checked}</td><td>{next}</td><td>{issues.join(' · ') || '—'}</td>
            </tr>
          ))}
        </tbody>
      </table></div>
    </section>

    <section class="sec tick">
      <h2>운영자 결정·확인 대기</h2>
      <p class="desc sub">끝난 항목은 <code>src/data/admin-todo.ts</code>에서 지워 주세요.</p>
      <ol class="todos">
        {todos.map((t) => <li><strong>{t.title}</strong> <span class="ref">{t.ref}</span><br />{t.detail}</li>)}
      </ol>
    </section>
  </div>
</Base>

<style>
  .page { padding-top: var(--space-6); max-width: 1200px; }
  .kicker { font-weight: 700; margin: 0 0 var(--space-1); color: var(--color-accent-text); }
  .lead { margin: 0 0 var(--space-5); }
  .sub { margin: 0 0 var(--space-4); }
  code { font-size: .9em; background: rgba(51, 56, 35, .07); padding: 1px 5px; }
  .tiles { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); border: 1px solid var(--color-text); }
  .tiles li { padding: 14px 16px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); display: flex; flex-direction: column; }
  .tiles strong { font-size: 32px; line-height: 1.1; }
  .tiles span { font-size: 15px; font-weight: 700; }
  .tiles .bad { background: var(--color-accent); color: var(--color-on-strong); }
  .tiles .warn strong { color: var(--color-accent-text); }
  .note { margin: var(--space-3) 0 0; font-size: 15px; }
  .empty { margin: 0; font-size: 17px; }
  .scroll { overflow-x: auto; border: 1px solid var(--line); }
  table { width: 100%; border-collapse: collapse; font-size: 15px; background: #fff; }
  th, td { text-align: left; vertical-align: top; padding: 8px 10px; border-bottom: 1px solid var(--line); }
  th { background: rgba(123, 158, 137, .12); white-space: nowrap; }
  td { min-width: 6em; }
  tr.bad td { background: rgba(243, 91, 4, .12); }
  tr.bad .state { color: var(--color-accent-text); font-weight: 800; }
  tr.warn .state { color: var(--color-accent-text); font-weight: 700; }
  .state { white-space: nowrap; }
  .id { display: block; font-size: 13px; opacity: .7; }
  .file { font-size: 13px; word-break: break-all; }
  .todos { margin: 0; padding-left: 1.4em; font-size: 16px; }
  .todos li { padding: 8px 0; border-bottom: 1px dashed var(--line); }
  .ref { font-size: 13px; font-weight: 700; color: var(--color-accent-text); }
</style>
