---
// SCR-U-001 소개·문의·운영고지 (푸터 페이지) — 상세 페이지와 같은 구역 상자(.sec .tick)로 나눔
import Base from '../layouts/Base.astro';
import Slot from '../components/wf/Slot.astro';
import MailForm from '../components/wf/MailForm.astro';
import { INFO_PAGES, type InfoPage } from '../data/info';
import { href } from '../data/cases';

export function getStaticPaths() {
  return INFO_PAGES.map((p) => ({ params: { info: p.id }, props: { p } }));
}
const { p } = Astro.props as { p: InfoPage };

// 서비스 소개 구역 아이콘: 가는 선·각진 모서리 (사이트 스타일)
const ICONS: Record<string, string> = {
  // 시선 — 눈 + 마름모 눈동자(로고)
  eye: '<path d="M4 20Q20 6 36 20Q20 34 4 20Z"/><path d="M20 14 26 20 20 26 14 20Z"/>',
  // 안식처 — 집
  home: '<path d="M5 19 20 6 35 19"/><path d="M10 15V34H30V15"/><path d="M17 34V25H23V34"/>',
  // 해결책 — 갈림길 표지판
  route: '<path d="M20 5V35"/><path d="M20 9H31L35 13 31 17H20"/><path d="M20 20H9L5 24 9 28H20"/>',
};
---
<Base title={p.title} description={p.lead} sensitive={p.sensitive} index={!p.draftNote}>
  <div class={`wrap page page--${p.id}`}>
    <section class="sec tick opening">
      {p.kicker && <p class="kicker">{p.kicker}</p>}
      <h1>{p.headline ?? p.title}</h1>
      <p class="lead desc">{p.lead}</p>
      {p.draftNote && <p class="draft-note" role="note">{p.draftNote}</p>}
    </section>
    {p.sections.map((s) => (
      <section class="sec tick">
        {s.icon ? (
          <div class="ihead">
            <span class="icon" aria-hidden="true">
              <svg width="40" height="40" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="miter" stroke-linecap="square" set:html={ICONS[s.icon]} />
            </span>
            <h2>{s.heading}</h2>
          </div>
        ) : <h2>{s.heading}</h2>}
        {s.text && <p>{s.text}</p>}
        {s.items && <ul class="points">{s.items.map((i) => <li>{typeof i === 'string' ? i : <><strong>{i.term}</strong>: {i.text}</>}</li>)}</ul>}
        {s.mail && <MailForm />}
        {s.slot && <Slot as="div" label={s.slot.label} note={s.slot.note} />}
        {s.link && <a class="more btn-accent" href={href(s.link.to)}>{s.link.label} <span class="arrow" aria-hidden="true">→</span></a>}
        {p.id === 'contact' && s.heading === '긴급한 도움이 필요하다면' && (
          <a class="go btn-accent" href={href('help/')}>긴급 도움 보기 →</a>
        )}
      </section>
    ))}
  </div>
</Base>

<style>
  .page { padding-top: var(--space-6); max-width: 880px; }
  .kicker { font-weight: 700; margin: 0 0 var(--space-1); color: var(--color-brand-secondary-strong); }
  .lead { margin: 0; }
  .draft-note { margin: var(--space-4) 0 0; padding: 10px 14px; border-left: 4px solid var(--color-accent-text); background: #fff; font-weight: 600; }
  .sec h2 { margin-bottom: var(--space-4); }
  .sec p { margin: 0 0 var(--space-3); }
  /* 서비스 소개 본문: 첫 소개 문장(.desc)과 같은 크기 */
  .page--about .sec p { font-size: 18px; line-height: 1.6; }
  /* 아이콘 + 제목 한 줄 */
  .ihead { display: flex; align-items: center; gap: var(--space-4); margin-bottom: var(--space-4); }
  .ihead h2 { margin: 0; }
  .icon {
    flex: none; display: inline-flex; align-items: center; justify-content: center; width: 64px; height: 64px;
    color: var(--color-brand-secondary-strong);
  }
  .points { list-style: none; margin: 0; padding: 0; }
  .points li { position: relative; padding: 7px 0 7px 20px; border-bottom: 1px dashed var(--line); }
  .points li:last-child { border-bottom: 0; }
  .points li::before { content: ''; position: absolute; left: 4px; top: 16px; width: 6px; height: 6px; background: var(--color-text); }
  .more {
    display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 18px; margin-top: var(--space-4);
    border: 1px solid var(--color-text); font-weight: 700; text-decoration: none;
  }
  .more .arrow { font-family: var(--font-mono); }
  .go {
    display: inline-flex; align-items: center; min-height: 48px; padding: 0 20px; margin-top: var(--space-2);
    background: var(--color-emergency); color: var(--color-on-strong); border: 1px solid var(--color-emergency); font-weight: 700; text-decoration: none;
  }
</style>
